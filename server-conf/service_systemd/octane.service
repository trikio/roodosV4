[Unit]
Description=Roodos Octane (Swoole)
After=network.target manticore.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/app
ExecStart=/usr/bin/php8.4 artisan octane:start --server=swoole --host=0.0.0.0 --port=8000
ExecReload=/usr/bin/php8.4 artisan octane:reload --server=swoole
# Started with nohup, Octane died when the disk filled up and nothing brought it back
# (outage of 2026-11-01).
Restart=always
RestartSec=3
TimeoutStopSec=30
StandardOutput=append:/var/log/octane.log
StandardError=append:/var/log/octane.log

[Install]
WantedBy=multi-user.target
