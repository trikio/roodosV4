[Unit]
Description=Roodos Laravel Octane (Swoole)
After=network.target manticore.service
Wants=manticore.service

[Service]
Type=simple
# Mismo usuario con el que corría antes vía "sudo nohup"; /app y storage/ son de root.
User=root
Group=root
WorkingDirectory=/app
ExecStart=/usr/bin/php8.4 artisan octane:start --server=swoole --host=127.0.0.1 --port=8000
ExecReload=/usr/bin/php8.4 artisan octane:reload --server=swoole
Restart=always
RestartSec=3
StandardOutput=append:/var/log/octane.log
StandardError=append:/var/log/octane.log
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
