[Unit]
Description=Manticore Search Engine
After=network.target remote-fs.target nss-lookup.target
Documentation=https://manual.manticoresearch.com/, man:searchd(1)
StartLimitIntervalSec=0

[Service]
Type=forking
User=root
Group=root
RuntimeDirectory=manticore

ExecStart=/usr/bin/searchd --config /etc/manticoresearch/manticore.conf
# --stopwait returns only once searchd is gone. With --stop a restart started the new searchd
# while the old one still held binlog.lock, and the new one died (outage of 2026-10-23).
ExecStop=/usr/bin/searchd --config /etc/manticoresearch/manticore.conf --stopwait
KillMode=process
KillSignal=SIGTERM
# A searchd stuck in shutdown is killed after TimeoutStopSec. With SendSIGKILL=no it stayed
# alive holding binlog.lock and every new start died for 4 hours (outage of 2026-10-28).
SendSIGKILL=yes
LimitNOFILE=65536
LimitCORE=infinity
LimitMEMLOCK=infinity
Restart=always
RestartSec=5
# A start that never completes fails and is retried instead of hanging forever.
TimeoutStartSec=300
TimeoutStopSec=120
PIDFile=/run/manticore/searchd.pid
RuntimeDirectoryMode=0755
WorkingDirectory=/var/lib/manticore

[Install]
WantedBy=multi-user.target
Alias=searchd.service
